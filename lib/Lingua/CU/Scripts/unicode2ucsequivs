use utf8;
# this is unicode2ucsequivs - reverse mapping of ucsequivs for Unicode to UCS conversion
# Generated mapping from Unicode sequences to UCS8 characters

# Basic combining characters - case-sensitive mapping
chr(0x0301) => '1',  # COMBINING ACUTE ACCENT -> lowercase
chr(0x0300) => '2',  # COMBINING GRAVE ACCENT -> lowercase
chr(0x0486) => '3',  # COMBINING CYRILLIC PSILI PNEUMATA -> lowercase
